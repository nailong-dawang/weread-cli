#!/usr/bin/env python3
"""WeRead (微信读书) API CLI via the Agent API Gateway.

Usage:
    weread search "三体" [--scope 10] [--count 10]
    weread book <bookId>
    weread shelf
    weread notes <bookId> [--count 20]
    weread readdata
    weread recommend [--count 10]
    weread call <api_name> [--param k=v ...]

Prints the gateway JSON response to stdout.
Auth: uses the `custom.weread` connector (Bearer token). The user must
provide their WeRead API key (wrk-...) via credentials.request_api_access
with provider "weread" first.
"""
import argparse
import json
import os
import sys
import urllib.request
import urllib.error

def read_json_response(resp):
    import json
    return json.loads(resp.read().decode())

SKILL_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
GATEWAY = "https://i.weread.qq.com/api/agent/gateway"
SKILL_VERSION = "1.0.4"

def get_api_key():
    key = os.environ.get("WEREAD_API_KEY", "")
    if not key:
        raise RuntimeError("Set WEREAD_API_KEY environment variable first")
    return key


def call(api_name, **params):
    body = {"api_name": api_name, "skill_version": SKILL_VERSION}
    body.update(params)
    data = json.dumps(body).encode()
    req = urllib.request.Request(
        GATEWAY,
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    req.add_header("Authorization", "Bearer " + get_api_key())
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            result = read_json_response(resp)
    except urllib.error.HTTPError as exc:
        raise RuntimeError(f"HTTP {exc.code}: {exc.read().decode()[:300]}")
    if isinstance(result, dict) and result.get("upgrade_info"):
        raise RuntimeError(
            "Skill upgrade required: "
            + str(result["upgrade_info"].get("message", ""))
        )
    return result


def main() -> int:
    ap = argparse.ArgumentParser(prog="weread")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("search", help="搜索书籍")
    p.add_argument("keyword")
    p.add_argument("--scope", type=int, default=10)
    p.add_argument("--count", type=int, default=10)

    p = sub.add_parser("book", help="书籍详情")
    p.add_argument("bookId")

    sub.add_parser("shelf", help="我的书架")

    p = sub.add_parser("notes", help="书的笔记划线")
    p.add_argument("bookId")
    p.add_argument("--count", type=int, default=20)

    sub.add_parser("readdata", help="阅读统计")

    p = sub.add_parser("recommend", help="个性化推荐")
    p.add_argument("--count", type=int, default=10)

    p = sub.add_parser("call", help="直接调任意接口")
    p.add_argument("api_name")
    p.add_argument("--param", action="append", default=[],
                   help="k=v, 可重复")

    args = ap.parse_args()
    try:
        if args.cmd == "search":
            out = call("/store/search", keyword=args.keyword,
                       scope=args.scope, count=args.count)
        elif args.cmd == "book":
            out = call("/book/info", bookId=args.bookId)
        elif args.cmd == "shelf":
            out = call("/shelf/sync")
        elif args.cmd == "notes":
            out = call("/book/notes", bookId=args.bookId,
                       count=args.count)
        elif args.cmd == "readdata":
            out = call("/readdata/summary")
        elif args.cmd == "recommend":
            out = call("/book/recommend", count=args.count)
        elif args.cmd == "call":
            params = {}
            for kv in args.param:
                k, _, v = kv.partition("=")
                params[k] = v
            out = call(args.api_name, **params)
    except (DynamicCredentialError, RuntimeError, OSError) as exc:
        print(json.dumps({"error": str(exc)}, ensure_ascii=False),
              file=sys.stderr)
        return 1

    print(json.dumps(out, ensure_ascii=False, indent=1))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
